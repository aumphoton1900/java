package SerializationExamples_01;

import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.io.Serializable;


class ChildClass1 extends BaseClass1 {
	private static final long serialVersionUID = 1L; // Recommended for versioning
	String childName;

	public ChildClass1(int baseValue, String childName) {
		super(baseValue);
		this.childName = childName;
	}

	public String getChildName() {
		return childName;
	}
}



class ChildClass extends BaseClass implements Serializable {
	private static final long serialVersionUID = 1L; // Recommended for versioning
	String childName;

	public ChildClass(int baseValue, String childName) {
		super(baseValue);
		this.childName = childName;
	}

	public String getChildName() {
		return childName;
	}
}

//Non-serializable base class
class BaseClass {
	int baseValue;

	public BaseClass() {
		// Default constructor is crucial for deserialization
		this.baseValue = 0;
	}

	public BaseClass(int baseValue) {
		this.baseValue = baseValue;
	}

	public int getBaseValue() {
		return baseValue;
	}
}

//Non-serializable base class
class BaseClass1 implements Serializable {
	int baseValue;

	public BaseClass1() {
		// Default constructor is crucial for deserialization
		this.baseValue = 0;
	}

	public BaseClass1(int baseValue) {
		this.baseValue = baseValue;
	}

	public int getBaseValue() {
		return baseValue;
	}
}

public class SerializationExample {

	public static void main01(String[] args) {
		ChildClass originalChild = new ChildClass(100, "Serializable Child");

		String path ="C://Users//NatwarKumar//Activity//daily//tasks//child.ser";
		// Serialize the ChildClass object
		try (ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream(path))) {
			oos.writeObject(originalChild);
			System.out.println("ChildClass object serialized successfully.");
		} catch (IOException e) {
			e.printStackTrace();
		}

		// Deserialize the ChildClass object
		try (ObjectInputStream ois = new ObjectInputStream(new FileInputStream(path))) {
			ChildClass deserializedChild = (ChildClass) ois.readObject();
			System.out.println("ChildClass object deserialized successfully.");

			System.out.println("Deserialized Base Value: " + deserializedChild.getBaseValue());
			System.out.println("Deserialized Child Name: " + deserializedChild.getChildName());

		} catch (IOException | ClassNotFoundException e) {
			e.printStackTrace();
		}
	}
	
	
